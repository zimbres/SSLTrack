<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
	
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
	
	
    <link href="app.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.ico" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <script suppress-error="BL9992">
        window.sslTrack = { setThemeCookie: function (dark) { document.cookie = "isDarkMode=" + dark + ";path=/;max-age=31536000;SameSite=Lax"; } };
        (function () {
            try
            {
                var v = localStorage.getItem('isDarkMode');
                if (v !== null)
                {
                    document.cookie = 'isDarkMode=' + JSON.parse(v) + ';path=/;max-age=31536000;SameSite=Lax';
                }
            }
            catch (e)
            {
            }
        })();
    </script>
    <script src="js/hangfire-frame.js"></script>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
	<script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code
{
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? PageRenderMode => HttpContext.User.Identity?.IsAuthenticated == true ? InteractiveServer : null;
}
