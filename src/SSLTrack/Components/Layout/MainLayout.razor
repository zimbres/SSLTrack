@inherits LayoutComponentBase
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<PageTitle>SSLTrack - SSL Certificates Monitoring</PageTitle>

<MudLayout Class="ssltrack-layout">
    <MudAppBar Elevation="1">
        <AuthorizeView><MudIconButton aria-label="Toggle navigation" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" /></AuthorizeView>
        <MudIcon Icon="@Icons.Material.Outlined.Lock" />
        <MudText Typo="Typo.h5" Class="ml-3">SSLTrack</MudText>
        <MudSpacer />
        <AuthorizeView><MudSwitch T="bool" Label="Light/Dark" Class="ma-4" Color="Color.Primary" Value="@_isDarkMode" ValueChanged="OnThemeChanged" /></AuthorizeView>
    </MudAppBar>
    <AuthorizeView Context="session"><MudDrawer Class="monitoring-sidebar" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu ShowNavigation="@(!session.User.HasClaim("password_change", "True"))" />
    </MudDrawer></AuthorizeView>
    <MudMainContent Class="ssltrack-main-content">
        @Body
    </MudMainContent>
    <MudAppBar Class="app-footer" Elevation="1" Bottom="true" Dense="true" Fixed="true" Style="z-index: 1000;">
        <MudGrid Justify="Justify.Center">
            <MudItem>
                <MudLink Href="https://github.com/zimbres/SSLTrack" Target="_blank" Color="Color.Inherit" Underline="Underline.None">
                    <MudIcon Icon="@Icons.Custom.Brands.GitHub" Title="GitHub" />
                </MudLink>
            </MudItem>
        </MudGrid>
    </MudAppBar>
</MudLayout>

@code
{
    private bool _drawerOpen = true;
    private MudTheme _theme = new();
    private bool _isDarkMode;
    protected override void OnInitialized()
    {
        var cookie = HttpContextAccessor.HttpContext?.Request.Cookies["isDarkMode"];
        if (bool.TryParse(cookie, out var darkMode))
        {
            _isDarkMode = darkMode;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await localStorage.GetItemAsync<bool?>("isDarkMode");
            if (stored is null)
            {
                stored = _isDarkMode;
                await localStorage.SetItemAsync("isDarkMode", stored.Value);
            }

            await JS.InvokeVoidAsync("sslTrack.setThemeCookie", stored.Value);
            if (stored.Value != _isDarkMode)
            {
                _isDarkMode = stored.Value;
                StateHasChanged();
            }
        }
    }

    private async Task OnThemeChanged(bool value)
    {
        _isDarkMode = value;
        await localStorage.SetItemAsync("isDarkMode", value);
        await JS.InvokeVoidAsync("sslTrack.setThemeCookie", value);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
