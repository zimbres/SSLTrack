@inject AccessGuard Access
@page "/notifications"
@attribute [Authorize(Policy = "Admin")]
@inject SmtpSettingsService Settings
<MudCard Class="account-panel account-panel-wide">
    <MudText Typo="Typo.h4" HtmlTag="h1">SMTP configuration</MudText>
    <MudText Class="account-intro">Configure delivery for certificate alerts. Saved settings are used by the next notification.</MudText>
    <AccountNotice />
    <form method="post" action="/account/smtp" data-enhance="false">
        <AntiforgeryToken />
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="edit.Name" name="Name" Label="Sender name" MaxLength="100" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="edit.MailFrom" name="MailFrom" Label="Sender email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="edit.MailTo" name="MailTo" Label="Recipients" Required="true" Variant="Variant.Outlined" HelperText="Separate email addresses with semicolons." /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="edit.Bcc" name="Bcc" Label="BCC" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="edit.SmtpHost" name="SmtpHost" Label="SMTP host" Required="true" MaxLength="253" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="edit.Port" name="Port" Label="Port" Min="1" Max="65535" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="SecureSocketOptions" @bind-Value="edit.TlsMode" Label="TLS mode" Variant="Variant.Outlined">
                    <MudSelectItem T="SecureSocketOptions" Value="SecureSocketOptions.StartTls">STARTTLS (required)</MudSelectItem>
                    <MudSelectItem T="SecureSocketOptions" Value="SecureSocketOptions.SslOnConnect">TLS on connect</MudSelectItem>
                    <MudSelectItem T="SecureSocketOptions" Value="SecureSocketOptions.None">None</MudSelectItem>
                </MudSelect><input type="hidden" name="TlsMode" value="@edit.TlsMode" />
            </MudItem>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="edit.Username" name="Username" Label="Username" Variant="Variant.Outlined" autocomplete="off" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="edit.Password" name="Password" Label="SMTP password" InputType="InputType.Password" Variant="Variant.Outlined" autocomplete="new-password" HelperText="@(edit.HasPassword ? "A password is saved. Leave blank to keep it." : "No password is saved.")" /></MudItem>
            <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="edit.ClearPassword" Label="Clear saved SMTP password" Color="Color.Primary" /><input type="hidden" name="ClearPassword" value="@edit.ClearPassword.ToString()" /></MudItem>
            <MudItem xs="12"><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save SMTP configuration</MudButton></MudItem>
        </MudGrid>
    </form>
    <MudDivider Class="my-8" />
    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Test delivery</MudText>
    <MudText Class="mb-4">Save changes first. The test uses the saved configuration and recipients.</MudText>
    <form method="post" action="/account/smtp/test" data-enhance="false"><AntiforgeryToken /><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send">Send test notification</MudButton></form>
</MudCard>
@code
{
    private SmtpSettingsEdit edit = new();
    protected override async Task OnInitializedAsync()
    {
        await Access.RequireAdminAsync();
        edit = await Settings.GetForEditAsync();
    }
}
