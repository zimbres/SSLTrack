@page "/change-password"
@attribute [Authorize(Policy="Human")]
@inject AuthenticationStateProvider AuthenticationState
@inject AccountService Accounts
<MudCard Class="account-panel account-panel-narrow">
    <MudText Typo="Typo.h4" HtmlTag="h1">Change password</MudText>
    <AccountNotice />
    @if (user?.AuthenticationType == "Local")
    {
        <MudText Class="account-intro">@(user.RequirePasswordChange ? "You must change your password before continuing." : "Choose a new password to protect your account.")</MudText>
        <form method="post" action="/account/password" data-enhance="false">
            <AntiforgeryToken />
            <MudStack Spacing="3">
                <MudTextField T="string" name="currentPassword" Label="Current password" InputType="InputType.Password" autocomplete="current-password" Required="true" MaxLength="128" Variant="Variant.Outlined" />
                <MudTextField T="string" name="newPassword" Label="New password" InputType="InputType.Password" autocomplete="new-password" Required="true" minlength="12" MaxLength="128" Variant="Variant.Outlined" />
                <MudTextField T="string" name="confirmPassword" Label="Confirm new password" InputType="InputType.Password" autocomplete="new-password" Required="true" minlength="12" MaxLength="128" Variant="Variant.Outlined" />
                <MudText Typo="Typo.body2">Use 12–128 characters. You’ll sign in again after saving.</MudText>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Change password</MudButton>
            </MudStack>
        </form>
    }
    else
    {
        <MudText Class="mt-4">Your password is managed by your identity provider.</MudText>
    }
</MudCard>
@code
{
    private AppUser? user;
    protected override async Task OnInitializedAsync()
    {
        user = await Accounts.CurrentAsync((await AuthenticationState.GetAuthenticationStateAsync()).User, true);
    }
}
