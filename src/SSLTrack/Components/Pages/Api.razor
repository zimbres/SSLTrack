@attribute [Authorize(Policy="Human")]
@page "/api"

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudText Typo="Typo.h5" GutterBottom="true">Api</MudText>
    <MudCard Class="mt-4">
        <MudCardContent>
            <MudLink Href="/api/swagger" Target="_blank" Color="Color.Primary">
                Api Version: @version
            </MudLink>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code
{
    private string? version;
    protected override void OnInitialized()
    {
        version = Assembly.GetExecutingAssembly().GetName().Version?.ToString();
    }
}
