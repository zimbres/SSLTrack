@inject AccessGuard Access
@page "/service-accounts"
@attribute [Authorize(Policy="Admin")]
@inject ServiceAccountService Accounts
@inject IAgentRepository Agents
@inject NavigationManager Navigation
<MudCard Class="account-panel account-panel-wide">
    <MudText Typo="Typo.h4" HtmlTag="h1">Agent service accounts</MudText>
    <MudText Class="account-intro">Give each agent its own credentials. An account can report only for its assigned agent.</MudText>
    <AccountNotice />
    <MudTable T="ServiceAccountEdit" Items="accounts" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" aria-label="Agent service accounts">
        <HeaderContent><MudTh>Email</MudTh><MudTh>Assigned agent</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Assigned agent">@agents.FirstOrDefault(x => x.Id == context.AgentId)?.Name (#@context.AgentId)</MudTd>
            <MudTd DataLabel="Status">@(context.Enabled ? "Enabled" : "Disabled")</MudTd>
            <MudTd DataLabel="Actions"><MudButton Href="@($"/service-accounts?edit={context.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Edit / rotate password</MudButton></MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-8 mb-4">
        <MudText Typo="Typo.h6" HtmlTag="h2">@(edit.Id == 0 ? "Create service account" : "Edit service account")</MudText>
        @if (edit.Id != 0)
        {
            <MudLink Href="/service-accounts">Create another account</MudLink>
        }
    </MudStack>
    @if (agents.Count == 0)
    {
        <MudText>Create a remote agent on the <MudLink Href="/agents">Agents page</MudLink> first.</MudText>
    }
    else
    {
        <AccountForm OnSubmit="SaveAsync">
            <AntiforgeryToken /><input type="hidden" name="Id" value="@edit.Id" />
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="edit.Email" name="Email" Label="Email / agent username" InputType="InputType.Email" Required="true" MaxLength="254" Variant="Variant.Outlined" autocomplete="off" /></MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="edit.AgentId" Label="Assigned agent" Required="true" Variant="Variant.Outlined">
                        @foreach (var agent in agents)
                        {
                            <MudSelectItem T="int" Value="agent.Id">@agent.Name (#@agent.Id)</MudSelectItem>
                        }
                    </MudSelect><input type="hidden" name="AgentId" value="@edit.AgentId" />
                </MudItem>
                <MudItem xs="12"><MudTextField T="string" @bind-Value="password" name="password" Label="@(edit.Id == 0 ? "Password" : "Replacement password")" InputType="InputType.Password" Required="@(edit.Id == 0)" minlength="12" MaxLength="128" Variant="Variant.Outlined" autocomplete="new-password" HelperText="12–128 characters. Existing passwords are never displayed. Leave blank to keep the current password." /></MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="edit.Enabled" Label="Enabled" Color="Color.Primary" /><input type="hidden" name="Enabled" value="@edit.Enabled.ToString()" /></MudItem>
                <MudItem xs="12"><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@(edit.Id == 0 ? "Create service account" : "Save service account")</MudButton></MudItem>
            </MudGrid>
        </AccountForm>
    }
    @if (edit.Id != 0)
    {
        <MudDivider Class="my-8" /><MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Remove service account</MudText>
        <MudText Class="mb-4">Removing this account permanently revokes its credentials. The agent will stop reporting until another account is configured.</MudText>
        <AccountForm OnSubmit="DeleteAsync"><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Remove service account</MudButton></AccountForm>
    }
    <MudDivider Class="my-8" /><MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">Configure the agent</MudText>
    <MudText>Set <code>AuthType</code> to <code>Basic</code>, <code>Username</code> to the account’s email, <code>Password</code> to its password, and <code>AgentId</code> to the assigned agent. Use an HTTPS <code>SSLTrackApiAddress</code>.</MudText>
    <MudText Typo="Typo.body2" Class="mt-2">Service accounts cannot sign in to the website. Disabling an account or rotating its password takes effect on the next API request.</MudText>
</MudCard>
@code
{
    [SupplyParameterFromQuery(Name = "edit")]
    public int? EditId { get; set; }

    private List<ServiceAccountEdit> accounts = new();
    private List<Agent> agents = new();
    private ServiceAccountEdit edit = new();
    private string? password;
    private async Task SaveAsync()
    {
        await Accounts.SaveAsync(edit, password);
        password = null;
        EditId = null;
        await OnParametersSetAsync();
        Navigation.NavigateTo("/service-accounts", replace: true);
    }
    private async Task DeleteAsync()
    {
        await Accounts.DeleteAsync(edit.Id);
        EditId = null;
        await OnParametersSetAsync();
        Navigation.NavigateTo("/service-accounts", replace: true);
    }
    protected override async Task OnParametersSetAsync()
    {
        await Access.RequireAdminAsync();
        accounts = await Accounts.ListAsync();
        agents = (await Agents.GetAll()).Where(x => x.Id > 1).ToList();
        edit = accounts.FirstOrDefault(x => x.Id == EditId) ?? new ServiceAccountEdit
        {
            AgentId = agents.FirstOrDefault()?.Id ?? 0
        };
        password = null;
    }
}
